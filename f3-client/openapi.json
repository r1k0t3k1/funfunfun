{
  "openapi": "3.1.0",
  "info": {
    "title": "adapter_in_web",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/after-login/upload": {
      "post": {
        "tags": [
          "crate::controller::file_upload_controller"
        ],
        "operationId": "upload_file",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadFile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "アップロード成功"
          },
          "400": {
            "description": "アップロード失敗"
          }
        }
      }
    },
    "/agent/get": {
      "get": {
        "tags": [
          "crate::controller::agent_controller"
        ],
        "operationId": "get_agent",
        "parameters": [
          {
            "name": "agent_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse"
                }
              }
            }
          },
          "500": {
            "description": "ハンドリングできない異常"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/agent/list": {
      "get": {
        "tags": [
          "crate::controller::agent_controller"
        ],
        "operationId": "list_agents",
        "parameters": [
          {
            "name": "listener_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listenerが管理するAgentの一覧",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgentResponse"
                  }
                }
              }
            }
          },
          "500": {
            "description": "ハンドリングできない異常"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "crate::controller::auth_controller"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "ログイン成功"
          },
          "401": {
            "description": "認証情報が正しくない"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "crate::controller::auth_controller"
        ],
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "ログアウト成功（未認証状態で実行しても成功扱い）"
          }
        }
      }
    },
    "/health/db": {
      "get": {
        "tags": [
          "crate::controller::health_controller"
        ],
        "operationId": "health_check_db",
        "responses": {
          "200": {
            "description": "DBが正常に起動している"
          },
          "500": {
            "description": "DBが起動していない、またはクエリの実行に失敗した"
          }
        }
      }
    },
    "/listener/create": {
      "post": {
        "tags": [
          "crate::controller::listener_controller"
        ],
        "operationId": "create_listener",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateListenerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Listenerの作成に成功"
          },
          "500": {
            "description": "Listenerの作成に失敗"
          }
        },
        "security": [
          {
            "bearer_auth": [
              "Admin",
              "Write"
            ]
          }
        ]
      }
    },
    "/listener/list": {
      "get": {
        "tags": [
          "crate::controller::listener_controller"
        ],
        "operationId": "list_listeners",
        "responses": {
          "200": {
            "description": "Listenerの一覧",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ListenerResponse"
                  }
                }
              }
            }
          },
          "500": {
            "description": "ハンドリングできない異常"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/listener/remove": {
      "post": {
        "tags": [
          "crate::controller::listener_controller"
        ],
        "operationId": "remove_listener",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemoveListenerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Listenerの削除に成功"
          },
          "500": {
            "description": "Listenerの削除に失敗"
          }
        },
        "security": [
          {
            "bearer_auth": [
              "Admin",
              "Write"
            ]
          }
        ]
      }
    },
    "/listener/start": {
      "post": {
        "tags": [
          "crate::controller::listener_controller"
        ],
        "operationId": "start_listener",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartListenerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Listenerが正常に起動"
          },
          "500": {
            "description": "Listenerの起動に失敗"
          }
        },
        "security": [
          {
            "bearer_auth": [
              "Admin",
              "Write"
            ]
          }
        ]
      }
    },
    "/listener/stop": {
      "post": {
        "tags": [
          "crate::controller::listener_controller"
        ],
        "operationId": "stop_listener",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopListenerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Listenerが正常に停止"
          },
          "500": {
            "description": "Listenerの停止に失敗"
          }
        },
        "security": [
          {
            "bearer_auth": [
              "Admin",
              "Write"
            ]
          }
        ]
      }
    },
    "/operator/get": {
      "get": {
        "tags": [
          "crate::controller::operator_controller"
        ],
        "operationId": "get_operator",
        "parameters": [
          {
            "name": "operator_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "オペレータ詳細情報"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/operator/list": {
      "get": {
        "tags": [
          "crate::controller::operator_controller"
        ],
        "operationId": "list_operators",
        "responses": {
          "200": {
            "description": "オペレータ一覧"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/operator/toggle_status": {
      "post": {
        "tags": [
          "crate::controller::operator_controller"
        ],
        "operationId": "toggle_operator_status",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToggleOperatorStatusRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "有効化状態変更完了"
          }
        },
        "security": [
          {
            "bearer_auth": [
              "Admin"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AgentResponse": {
        "type": "object",
        "required": [
          "id",
          "listener_id",
          "process_id",
          "thread_id",
          "arch",
          "is_admin",
          "process_name",
          "os",
          "domain_name",
          "computer_name",
          "user_name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "listener_id": {
            "type": "string"
          },
          "process_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "thread_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "arch": {
            "type": "string"
          },
          "is_admin": {
            "type": "boolean"
          },
          "process_name": {
            "type": "string"
          },
          "os": {
            "type": "string"
          },
          "domain_name": {
            "type": "string"
          },
          "computer_name": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          }
        }
      },
      "AuthenticateRequest": {
        "type": "object",
        "required": [
          "operator_name",
          "password"
        ],
        "properties": {
          "operator_name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "CreateListenerRequest": {
        "type": "object",
        "required": [
          "name",
          "lhost",
          "lport",
          "config"
        ],
        "properties": {
          "lhost": {
            "type": "string"
          },
          "lport": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "config": {
            "$ref": "#/components/schemas/ListenerConfig"
          }
        }
      },
      "ListenerResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "lhost",
          "lport",
          "config"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "lhost": {
            "type": "string"
          },
          "lport": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "config": {
            "$ref": "#/components/schemas/ListenerConfig"
          }
        }
      },
      "ListenerConfig": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "protocol",
              "path",
              "user_agent",
              "host_header",
              "http_method",
              "is_ssl"
            ],
            "properties": {
              "protocol": {
                "type": "string",
                "enum": [
                  "Http"
                ]
              },
              "path": {
                "type": "string"
              },
              "user_agent": {
                "type": "string"
              },
              "host_header": {
                "type": "string"
              },
              "http_method": {
                "type": "string"
              },
              "is_ssl": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "protocol"
            ],
            "properties": {
              "protocol": {
                "type": "string",
                "enum": [
                  "Tcp"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "protocol"
            ],
            "properties": {
              "protocol": {
                "type": "string",
                "enum": [
                  "Dns"
                ]
              }
            }
          }
        ],
        "discriminator": {
          "propertyName": "protocol"
        }
      },
      "RemoveListenerRequest": {
        "type": "object",
        "required": [
          "listener_id"
        ],
        "properties": {
          "listener_id": {
            "type": "string"
          }
        }
      },
      "StartListenerRequest": {
        "type": "object",
        "required": [
          "listener_id"
        ],
        "properties": {
          "listener_id": {
            "type": "string"
          }
        }
      },
      "StopListenerRequest": {
        "type": "object",
        "required": [
          "listener_id"
        ],
        "properties": {
          "listener_id": {
            "type": "string"
          }
        }
      },
      "ToggleOperatorStatusRequest": {
        "type": "object",
        "required": [
          "operator_id"
        ],
        "properties": {
          "operator_id": {
            "type": "string"
          }
        }
      },
      "UploadFile": {
        "type": "object",
        "required": [
          "filename",
          "data"
        ],
        "properties": {
          "data": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer_auth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
